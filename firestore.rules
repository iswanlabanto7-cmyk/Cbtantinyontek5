rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all for all unmatched collections & documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Rules for Exams
    match /exams/{examId} {
      allow read, write, create, update, delete: if isSignedIn();
    }

    // Rules for User Profiles
    match /users/{userId} {
      allow read, write, create, update, delete: if isSignedIn();
    }

    // Rules for Client App Configurations
    match /client_configs/{configId} {
      allow read, write, create, update, delete: if isSignedIn();
    }
  }
}
