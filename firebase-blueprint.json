{
  "entities": {
    "Exam": {
      "title": "Exam",
      "description": "Dokumen konfigurasi ujian, link Google Form, dan 3 PIN keamanan CBT yang diisolasi ketat per pengguna",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Kode unik sesi ujian (contoh: EXAM-2026-001)",
          "maxLength": 64
        },
        "authorId": {
          "type": "string",
          "description": "UID pengguna pemilik data ujian",
          "maxLength": 128
        },
        "authorEmail": {
          "type": "string",
          "description": "Alamat email pembuat ujian",
          "maxLength": 150
        },
        "examTitle": {
          "type": "string",
          "description": "Judul atau nama pelaksanaan ujian",
          "maxLength": 200
        },
        "subject": {
          "type": "string",
          "description": "Mata pelajaran ujian",
          "maxLength": 150
        },
        "googleFormUrl": {
          "type": "string",
          "description": "URL lengkap lembar soal Google Form",
          "maxLength": 1000
        },
        "durationMinutes": {
          "type": "number",
          "description": "Durasi pengerjaan ujian dalam menit"
        },
        "pinMasuk": {
          "type": "string",
          "description": "PIN 4 digit untuk membuka soal",
          "maxLength": 10
        },
        "pinKeluar": {
          "type": "string",
          "description": "PIN 4 digit untuk keluar dari fullscreen ujian",
          "maxLength": 10
        },
        "pinPengawas": {
          "type": "string",
          "description": "PIN 4 digit untuk pengawas atau reset darurat",
          "maxLength": 10
        },
        "startTime": {
          "type": "string",
          "description": "Waktu mulai pelaksanaan ujian format ISO",
          "maxLength": 50
        },
        "endTime": {
          "type": "string",
          "description": "Waktu selesai pelaksanaan ujian format ISO",
          "maxLength": 50
        },
        "timezone": {
          "type": "string",
          "enum": ["WIB", "WITA", "WIT"],
          "description": "Zona waktu pelaksanaan ujian"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "active", "closed"],
          "description": "Status kesiapan ujian"
        },
        "allowedClasses": {
          "type": "array",
          "description": "Daftar kelas yang diizinkan mengikuti ujian"
        },
        "createdAt": {
          "type": "string",
          "description": "Waktu pembuatan dokumen",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pembaruan terakhir dokumen",
          "maxLength": 50
        }
      },
      "required": [
        "id",
        "authorId",
        "examTitle",
        "subject",
        "googleFormUrl",
        "durationMinutes",
        "pinMasuk",
        "pinKeluar",
        "pinPengawas",
        "status"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Data profil akun pengguna yang diproteksi secara privat",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "UID autentikasi Firebase pengguna",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Alamat email pengguna",
          "maxLength": 150
        },
        "displayName": {
          "type": "string",
          "description": "Nama tampilan pengguna",
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "description": "URL foto avatar profil pengguna",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "description": "Waktu pendaftaran profil",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pembaruan profil terakhir",
          "maxLength": 50
        }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/exams/{examId}": {
      "schema": "Exam",
      "description": "Koleksi data sesi ujian yang hanya dapat dibaca dan dikelola oleh pemiliknya sendiri (authorId == request.auth.uid)"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Koleksi profil akun pengguna yang hanya dapat dibaca dan ditulis oleh pengguna terkait (userId == request.auth.uid)"
    }
  }
}
